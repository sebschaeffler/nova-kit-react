{
  "name": "nova-kit-react",
  "private": false,
  "version": "1.1.1",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebschaeffler/nova-kit-react.git"
  },
  "author": "Sebastien Schaeffler",
  "license": "MIT",
  "keywords": [
    "react",
    "storybook",
    "ui-components",
    "typescript",
    "tailwindcss"
  ],
  "homepage": "https://github.com/sebschaeffler/nova-kit-react#readme",
  "bugs": {
    "url": "https://github.com/sebschaeffler/nova-kit-react/issues"
  },
  "contributors": [
    {
      "name": "Sebastien Schaeffler",
      "email": "sebastien@schaeffler.dev",
      "url": "https://github.com/sebschaeffler"
    }
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.es.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./components": {
      "import": {
        "types": "./dist/components.d.ts",
        "default": "./dist/components.es.js"
      },
      "require": {
        "types": "./dist/components.d.cts",
        "default": "./dist/components.cjs"
      }
    },
    "./lib": {
      "import": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.es.js"
      },
      "require": {
        "types": "./dist/lib.d.cts",
        "default": "./dist/lib.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.es.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.es.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./nova-styles.css": "./dist/nova-styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build-tsup",
    "build-vite": "tsc && vite build && npm run build:styles",
    "build:styles": "postcss src/nova-styles.css -o ./dist/nova-styles.css",
    "build-tsup": "tsup && npm run build:styles",
    "lint": "eslint src --report-unused-disable-directives",
    "tsc": "tsc",
    "pub:beta": "pnpm build && pnpm publish --no-git-checks --access public --tag beta",
    "pub:next": "pnpm build && pnpm publish --no-git-checks --access public --tag next",
    "pub:release": "pnpm build && pnpm publish --access public",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "jest --config jest.config.cjs"
  },
  "peerDependencies": {
    "react": "^19.0",
    "react-dom": "^19.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.4.0",
    "@tanstack/react-query": "^5.104.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.577.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^10.0.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "^9.9.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/addon-links": "^9.1.20",
    "@storybook/addon-onboarding": "^9.1.20",
    "@storybook/react-vite": "^9.1.20",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^9.1.20",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "lodash": "^4.18.1",
    "postcss": "^8.5.29",
    "postcss-cli": "^11.0.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "ts-jest": "^29.4.14",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vite-plugin-dts": "^4.5.4"
  },
  "overrides": {
    "storybook": "$storybook"
  }
}
